# ---------------------------------------------------------------------------
# Upstream (LigaPro public JSON API)
# ---------------------------------------------------------------------------
# Requests are built as:
#   <BASE_URL>/api/tournaments/<TOURNAMENT_ID>/positions     (every poll)
#   <BASE_URL>/api/tournaments/<TOURNAMENT_ID>/games         (every poll)
#   <BASE_URL>/api/tournaments/<TOURNAMENT_ID>               (jornada refresh)
#   <BASE_URL>/api/tournaments/<TOURNAMENT_ID>/groupweeks    (jornada refresh)
#   <BASE_URL>/api/tournaments/<TOURNAMENT_ID>/games?filter[groupweek][0]=<id>  (jornada refresh, one per jornada)
#   <BASE_URL>/api/games/<GAME_ID>/{info,events,mvps}        (only when someone opens a match)
UPSTREAM_BASE_URL=https://www.ligapro.uy
# The number in https://www.ligapro.uy/campeonatos/<id>. 549 = Serie 4 / Divisional B / Clausura 2026.
UPSTREAM_TOURNAMENT_ID=549
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_USER_AGENT=prort/1.0 (+standings mirror; contact: repo owner)

# ---------------------------------------------------------------------------
# Polling schedule
# ---------------------------------------------------------------------------
# Base interval between polls (standings + complete fixture), in minutes.
POLL_INTERVAL_MINUTES=5
# Each run is offset by a random delay drawn from [-J, +J] seconds. 0 disables jitter.
POLL_JITTER_SECONDS=30
# How often to re-read which jornada each game belongs to (about 17 requests), in minutes.
# A game that is new to the fixture triggers a refresh earlier.
JORNADA_REFRESH_MINUTES=60

# ---------------------------------------------------------------------------
# Match details (fetched on demand, never polled)
# ---------------------------------------------------------------------------
# How long a match's details are served from cache before asking LigaPro again, in minutes.
MATCH_DETAILS_TTL_MINUTES=15
# Upper bound on requests to LigaPro per minute for match details, whatever the traffic.
MATCH_DETAILS_REQUESTS_PER_MINUTE=20

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Zona horaria (IANA) para mostrar "última actualización". NO depende de la del
# servidor: un contenedor en UTC igual muestra hora uruguaya.
DISPLAY_TIMEZONE=America/Montevideo
# Optional public URL of this site, used in Telegram messages. Leave empty to omit.
SITE_URL=

# ---------------------------------------------------------------------------
# Snapshot (restart baseline for change detection; safe to lose)
# ---------------------------------------------------------------------------
SNAPSHOT_PATH=./data/snapshot.json

# ---------------------------------------------------------------------------
# Telegram notifications (optional)
# ---------------------------------------------------------------------------
# Leave both unset to run without notifications. They must be set together.
# El token te lo da @BotFather; el chat id, @userinfobot (o /getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Upper bound on messages sent for a single poll, so a pathological upstream
# reset cannot flood the chat. Default 5.
TELEGRAM_MAX_MESSAGES_PER_POLL=5
